{
  "name": "angelo-catalog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "check:strings": "node check-strings.mjs",
    "e2e": "playwright test",
    "e2e:visitor": "playwright test --project=visitor",
    "e2e:merchant": "playwright test --project=merchant",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:warm": "cross-env WAIT_ON_TIMEOUT=120000 playwright test e2e/warm.spec.ts --project=visitor", 
    "e2e:prod": "npm run build && cross-env E2E_BASE_URL=http://localhost:3000 playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@wrksz/themes": "^2.1.1",
    "browser-image-compression": "^2.0.2",
    "geist": "^1.9.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
